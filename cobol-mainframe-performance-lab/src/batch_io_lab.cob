>>SOURCE FORMAT IS FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. BATCH-IO-LAB.
ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT INPUT-FILE ASSIGN TO "data/input.dat"
        ORGANIZATION IS LINE SEQUENTIAL.
    SELECT OUTPUT-FILE ASSIGN TO "results/output.dat"
        ORGANIZATION IS LINE SEQUENTIAL.
DATA DIVISION.
FILE SECTION.
FD INPUT-FILE.
01 INPUT-RECORD PIC X(20).
FD OUTPUT-FILE.
01 OUTPUT-RECORD PIC X(20).
WORKING-STORAGE SECTION.
01 WS-EOF PIC X VALUE "N".
01 WS-RECORDS-READ PIC 9(7) VALUE 0.
01 WS-RECORDS-WRITTEN PIC 9(7) VALUE 0.
PROCEDURE DIVISION.
    OPEN INPUT INPUT-FILE OUTPUT OUTPUT-FILE
    PERFORM UNTIL WS-EOF = "Y"
        READ INPUT-FILE
            AT END
                MOVE "Y" TO WS-EOF
            NOT AT END
                ADD 1 TO WS-RECORDS-READ
                MOVE INPUT-RECORD TO OUTPUT-RECORD
                WRITE OUTPUT-RECORD
                ADD 1 TO WS-RECORDS-WRITTEN
        END-READ
    END-PERFORM
    CLOSE INPUT-FILE OUTPUT-FILE
    DISPLAY "========================================"
    DISPLAY "       COBOL BATCH I/O LAB"
    DISPLAY "========================================"
    DISPLAY "RECORDS READ    : " WS-RECORDS-READ
    DISPLAY "RECORDS WRITTEN : " WS-RECORDS-WRITTEN
    STOP RUN.
